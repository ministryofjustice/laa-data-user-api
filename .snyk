ignore:
  SNYK-CC-K8S-11:
    - '*':
        reason: "Low severity, mitigated elsewhere"

  SNYK-CC-K8S-42:
     - '*':
        reason: "Low severity, mitigated elsewhere"

  # org.glassfish.jaxb:jaxb-core 4.0.9 (XXE in XmlFactory), transitive via hibernate-core -> jaxb-runtime.
  # No fixed release is published yet (fix merged upstream, unreleased) so it cannot be upgraded.
  # Not exploitable here: the application does not parse untrusted XML; Hibernate only reads its own mapping files.
  # Re-check for a jaxb-core release containing the fix and remove this ignore when it lands.
  SNYK-JAVA-ORGGLASSFISHJAXB-20883142:
    - '*':
        reason: "No fix published; app does not unmarshal untrusted XML (Hibernate internal use only)"
        expires: 2026-12-11T00:00:00.000Z

  # CVE-2026-113602: json-smart may accept malformed trailing input after a 0x1A character
  # when strict JSON validation is used. Snyk reports no fixed version; currently test-only via JsonPath.
  # Review for an upstream fix and reassess scope by 2027-01-05.
  SNYK-JAVA-NETMINIDEV-21715438:
    - '*':
        reason: "CVE-2026-113602; no fixed version; test-only via JsonPath; review by 2027-01-05"
        expires: 2027-01-05T00:00:00.000Z
