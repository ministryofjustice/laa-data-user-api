package authz.permissions

import future.keywords.if

default caller_permissions := {"allow": false, "permissions": []}

caller_permissions := {"allow": true, "permissions": sort(permissions)} if {
	is_array(input.roles)
	every_role_is_string
	permissions := {permission |
		role := input.roles[_]
		application := role_permissions[_]
		permission := application[role][_]
	}
	count(permissions) > 0
}

every_role_is_string if {
	count([role | role := input.roles[_]; is_string(role)]) == count(input.roles)
}

role_permissions := {
	"Manage your users": {
		"Internal User Manager": {
